{
  "name": "favmov",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore",
    "build:web": "expo export --clear -p web && rm -rf ../backend/public && mv dist ../backend/public"
  },
  "dependencies": {
    "@babel/runtime": "^7.27.1",
    "@expo/metro-runtime": "~57.0.18",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/react-query": "^5.106.1",
    "axios": "^1.9.0",
    "expo": "^57.0.32",
    "expo-constants": "~57.0.23",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.30",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-image-zoom-viewer": "^3.0.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-toast-message": "^2.3.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.21",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.17",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "license": "GPL-2.0-only",
  "description": "Browse movies, TV shows and people, and save titles in personal collections with notes."
}
