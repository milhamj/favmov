{
  "expo": {
    "name": "favmov",
    "slug": "favmov",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app/FAVMOV_LOGO.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app/adaptive-icon.png",
        "backgroundColor": "#D32E25"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/app/favicon.png"
    },
    "plugins": ["expo-router", "expo-font"]
  }
}
